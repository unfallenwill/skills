{
  "mcpServers": {
    "acp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
      ],
      "env": {
        "HANDOFF_DEBUG": "${HANDOFF_DEBUG:-}",
        "HANDOFF_START_TIMEOUT_MS": "${HANDOFF_START_TIMEOUT_MS:-}"
      }
    }
  }
}
