{"rule_id": "PD-001", "category": "知情同意", "subcategory": "签署时点异常", "description": "知情同意书必须在任何方案规定操作之前签署", "condition": "DATEDIFF(ICF.ICFDAT, SV.SVSTDTC, 'day') > 0", "visits": "筛选期", "forms": "知情同意书", "fields": "ICF.ICFDAT, SV.SVSTDTC", "source_files": "方案.docx; DVP.xlsx", "source_locator": "§伦理 > 知情同意; <EditChecks>!R2-R2", "original_rule_ids": "DVP-001", "severity": "Major", "duplicate_of": "DVP-001", "review_status": "passed", "review_notes": "", "remarks": "2源合并", "rationale": "保证受试者在知情同意下参与任何方案操作，属伦理与受试者权益底线"}
{"rule_id": "PD-002", "category": "入选排除", "subcategory": "不符合入选条件", "description": "入选时受试者年龄须在 18-65 周岁（含临界值）", "condition": "DM.AGE NOT BETWEEN 18 AND 65", "visits": "筛选期", "forms": "人口学资料", "fields": "DM.AGE", "source_files": "方案.docx; DVP.xlsx", "source_locator": "§研究人群 > 入选标准; <EditChecks>!R3-R3", "original_rule_ids": "DVP-002", "severity": "Major", "duplicate_of": "DVP-002", "review_status": "passed", "review_notes": "", "remarks": "2源合并", "rationale": "保证入组人群符合方案定义的研究人群，维护受试者安全与结果可解释性"}
{"rule_id": "PD-003", "category": "访视", "subcategory": "超窗访视", "description": "每次访视实际日期不得超出计划窗口 ±3 天", "condition": "ABS(DATEDIFF(VISIT.VISDAT, VISIT.PLANNDT, 'day')) > 3", "visits": "所有访视", "forms": "访视日期", "fields": "VISIT.VISDAT, VISIT.PLANNDT", "source_files": "方案.docx; DVP.xlsx", "source_locator": "§访视流程 > 访视窗口; <EditChecks>!R4-R4", "original_rule_ids": "DVP-003", "severity": "Minor", "duplicate_of": "DVP-003", "review_status": "failed", "review_notes": "2 票 fail：窗口基准日期（首次给药日或随机日）在源文中存在歧义，需人工确认", "remarks": "2源合并；窗口计算依赖访视计划表", "rationale": "保证访视按方案时点执行，使数据在可比时间点采集，维护方案依从性"}
{"rule_id": "PD-004", "category": "给药", "subcategory": "给药依从性", "description": "给药依从性须维持在 80%-120% 区间", "condition": "(EX.ACTDOSE / EX.PRESCRIBED_DOSE) NOT BETWEEN 0.8 AND 1.2", "visits": "所有访视", "forms": "给药记录", "fields": "EX.ACTDOSE, EX.PRESCRIBED_DOSE", "source_files": "方案.docx", "source_locator": "§研究用药 > 依从性", "original_rule_ids": "", "severity": "", "duplicate_of": "", "review_status": "passed", "review_notes": "", "remarks": "严重程度无法依据现有标准判定", "rationale": "保证受试者按方案足量暴露于研究药物，避免暴露不足导致疗效评估失真"}
{"rule_id": "PD-005", "category": "合并用药", "subcategory": "记录不完整", "description": "所有合并用药须记录通用名", "condition": "CM.CMTRT IS NULL", "visits": "所有访视", "forms": "合并用药", "fields": "CM.CMTRT", "source_files": "DVP.xlsx", "source_locator": "<EditChecks>!R5-R5", "original_rule_ids": "DVP-004", "severity": "Minor", "duplicate_of": "", "review_status": "passed", "review_notes": "", "remarks": "", "rationale": "保证合并用药信息完整可溯源，支撑安全性评价与药物相互作用判断"}
